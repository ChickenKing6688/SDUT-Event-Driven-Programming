clean: compiler_clean 
	-$(DEL_FILE) release\Character.o release\Command.o release\CommandWords.o release\Parser.o release\Room.o release\ZorkUL.o release\item.o

distclean: clean 
	-$(DEL_FILE) .qmake.stash
	-$(DEL_FILE) $(DESTDIR_TARGET)
	-$(DEL_FILE) Makefile.Release

mocclean: compiler_moc_header_clean compiler_moc_objc_header_clean compiler_moc_source_clean

mocables: compiler_moc_header_make_all compiler_moc_objc_header_make_all compiler_moc_source_make_all

check: first

benchmark: first

compiler_no_pch_compiler_make_all:
compiler_no_pch_compiler_clean:
compiler_rcc_make_all:
compiler_rcc_clean:
compiler_moc_predefs_make_all: release/moc_predefs.h
compiler_moc_predefs_clean:
	-$(DEL_FILE) release\moc_predefs.h
release/moc_predefs.h: E:/Qt/6.11.0/mingw_64/mkspecs/features/data/dummy.cpp
	g++ -fno-keep-inline-dllexport -O2 -Wall -Wextra -Wextra -dM -E -o release\moc_predefs.h E:\Qt\6.11.0\mingw_64\mkspecs\features\data\dummy.cpp

compiler_moc_header_make_all:
compiler_moc_header_clean:
compiler_moc_objc_header_make_all:
compiler_moc_objc_header_clean:
compiler_moc_source_make_all:
compiler_moc_source_clean:
compiler_yacc_decl_make_all:
compiler_yacc_decl_clean:
compiler_yacc_impl_make_all:
compiler_yacc_impl_clean:
compiler_lex_make_all:
compiler_lex_clean:
compiler_clean: compiler_moc_predefs_clean 



####### Compile

release/Character.o: ../../Character.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release\Character.o ..\..\Character.cpp

release/Command.o: ../../Command.cpp ../../Command.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release\Command.o ..\..\Command.cpp

release/CommandWords.o: ../../CommandWords.cpp ../../CommandWords.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release\CommandWords.o ..\..\CommandWords.cpp

release/Parser.o: ../../Parser.cpp ../../Parser.h \
		../../Command.h \
		../../CommandWords.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release\Parser.o ..\..\Parser.cpp

release/Room.o: ../../Room.cpp ../../Room.h \
		../../item.h \
		../../Command.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release\Room.o ..\..\Room.cpp

release/ZorkUL.o: ../../ZorkUL.cpp ../../ZorkUL.h \
		../../Command.h \
		../../Parser.h \
		../../CommandWords.h \
		../../Room.h \
		../../item.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release\ZorkUL.o ..\..\ZorkUL.cpp

release/item.o: ../../item.cpp ../../item.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release\item.o ..\..\item.cpp

####### Install

install:  FORCE

uninstall:  FORCE

FORCE:

.SUFFIXES:

